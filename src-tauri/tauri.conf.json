{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "cal-widget",
  "version": "0.1.0",
  "identifier": "com.worean.calwidget",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "yarn dev",
    "beforeBuildCommand": "yarn build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Cal-Widget",
        "width": 380,
        "height": 540,
        "minWidth": 340,
        "minHeight": 420,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": true,
        "fullscreen": false,
        "skipTaskbar": true,
        "alwaysOnTop": false
      },
      {
        "label": "mascot",
        "title": "Cal-Widget Mascot",
        "url": "/?window=mascot",
        "width": 150,
        "height": 150,
        "x": 160,
        "y": 160,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "fullscreen": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
