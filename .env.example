# Cal-Widget Calendar API 테스트용 환경변수 예시
# 실제 사용 시 이 파일을 `.env.local`로 복사해 값을 채워주세요. (.env.local은 Git에 올라가지 않습니다)

# 1. Google Calendar OAuth 2.0 (Google Cloud Console > Desktop App 클라이언트)
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=

# 2. CalDAV (iCloud, Nextcloud, Synology, Fastmail 등)
VITE_CALDAV_URL=
VITE_CALDAV_USERNAME=
VITE_CALDAV_PASSWORD=
